# Server
PORT=5000
NODE_ENV=development

# Database
# Option A: single connection string (used if set, e.g. Render's Internal/External Database URL)
DATABASE_URL=
# Option B: individual fields (used if DATABASE_URL is not set)
DB_NAME=hikmah_ai
DB_USER=postgres
DB_PASSWORD=Amaan@23
DB_HOST=localhost
DB_PORT=5432
DB_SCHEMA=hikmah
# DB_SSL: with DATABASE_URL, SSL is ON by default (set DB_SSL=false to disable, e.g. for Render's Internal URL).
# With individual fields, SSL is OFF by default (set DB_SSL=true to enable, e.g. for Render's External URL).
DB_SSL=

# JWT
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRY=7d
JWT_ISSUER=hikmah-ai-backend

# AI provider — one of: openai | claude | openrouter | mock (mock = no API key, canned/template replies)
AI_PROVIDER=claude

OPENAI_API_KEY=replace-with-your-openai-key
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=replace-with-your-anthropic-key
CLAUDE_MODEL=claude-haiku-4-5-20251001

OPENROUTER_API_KEY=replace-with-your-openrouter-key
OPENROUTER_MODEL=openai/gpt-4o-mini
