# Server
PORT=5000
NODE_ENV=development

# Database
DB_NAME=hikmah_ai
DB_USER=postgres
DB_PASSWORD=Amaan@23
DB_HOST=localhost
DB_PORT=5432
DB_SCHEMA=hikmah

# JWT
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRY=7d
JWT_ISSUER=hikmah-ai-backend

# AI provider — switch to "claude" to route chat through Anthropic instead of OpenAI
AI_PROVIDER=openai

OPENAI_API_KEY=replace-with-your-openai-key
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=replace-with-your-anthropic-key
CLAUDE_MODEL=claude-sonnet-5
