      ]
    },
    {
      "name": "Scholar Applications",
      "item": [
        {
          "name": "Submit Application",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('application_id', body.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{base_url}}/scholar-applications", "host": ["{{base_url}}"], "path": ["scholar-applications"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Test User\",\n  \"qualifications\": \"Ijazah in Hadith, 10 years teaching experience\",\n  \"ijazah\": \"https://example.com/ijazah.pdf\"\n}"
            }
          }
        },
        {
          "name": "Submit Application (duplicate pending -> 409)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{base_url}}/scholar-applications", "host": ["{{base_url}}"], "path": ["scholar-applications"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Test User\",\n  \"qualifications\": \"Another application text here\"\n}"
            }
          }
        },
        {
          "name": "Get My Application Status",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/scholar-applications/me", "host": ["{{base_url}}"], "path": ["scholar-applications", "me"] }
          }
        },
        {
          "name": "List Applications (non-admin -> 403)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/scholar-applications", "host": ["{{base_url}}"], "path": ["scholar-applications"] }
          }
        },
        {
          "name": "List Applications (admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "url": { "raw": "{{base_url}}/scholar-applications", "host": ["{{base_url}}"], "path": ["scholar-applications"] }
          }
        },
        {
          "name": "Review Application (approve, admin)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/scholar-applications/{{application_id}}",
              "host": ["{{base_url}}"],
              "path": ["scholar-applications", "{{application_id}}"]
            },
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"approved\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Channels & Q&A",
      "item": [
        {
          "name": "Create Channel (non-admin -> 403)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{base_url}}/channels", "host": ["{{base_url}}"], "path": ["channels"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Fiqh\",\n  \"description\": \"Islamic jurisprudence questions\",\n  \"colorVariant\": \"blue\"\n}"
            }
          }
        },
        {
          "name": "Create Channel (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('channel_id', body.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{base_url}}/channels", "host": ["{{base_url}}"], "path": ["channels"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Fiqh\",\n  \"description\": \"Islamic jurisprudence questions\",\n  \"colorVariant\": \"blue\"\n}"
            }
          }
        },
        {
          "name": "List Channels",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/channels", "host": ["{{base_url}}"], "path": ["channels"] }
          }
        },
        {
          "name": "Get Channel",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{base_url}}/channels/{{channel_id}}",
              "host": ["{{base_url}}"],
              "path": ["channels", "{{channel_id}}"]
            }
          }
        },
        {
          "name": "Post Question",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('question_id', body.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/channels/{{channel_id}}/questions",
              "host": ["{{base_url}}"],
              "path": ["channels", "{{channel_id}}", "questions"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Is combining prayers allowed while traveling?\",\n  \"body\": \"I travel frequently for work, can I combine Dhuhr and Asr?\"\n}"
            }
          }
        },
        {
          "name": "List Questions in Channel",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{base_url}}/channels/{{channel_id}}/questions",
              "host": ["{{base_url}}"],
              "path": ["channels", "{{channel_id}}", "questions"]
            }
          }
        },
        {
          "name": "Post Reply",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/questions/{{question_id}}/replies",
              "host": ["{{base_url}}"],
              "path": ["questions", "{{question_id}}", "replies"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"body\": \"Yes, combining prayers (Jam) is permissible while traveling per majority scholarly opinion.\"\n}"
            }
          }
        },
        {
          "name": "Get Question (with replies)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  if (body.data.replies && body.data.replies.length) {",
                  "    pm.collectionVariables.set('reply_id', body.data.replies[0].id);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{base_url}}/questions/{{question_id}}",
              "host": ["{{base_url}}"],
              "path": ["questions", "{{question_id}}"]
            }
          }
        },
        {
          "name": "Verify Reply (non-scholar -> 403)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{base_url}}/replies/{{reply_id}}/verify",
              "host": ["{{base_url}}"],
              "path": ["replies", "{{reply_id}}", "verify"]
            }
          }
        },
        {
          "name": "Verify Reply (scholar/admin)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "url": {
              "raw": "{{base_url}}/replies/{{reply_id}}/verify",
              "host": ["{{base_url}}"],
              "path": ["replies", "{{reply_id}}", "verify"]
            }
          }
        }
      ]
    },
